meta {
  name: Create Report
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/reports
  body: json
  auth: inherit
}

body:json {
  {
    "targetType": "trail",
    "targetId": "{{trailId}}",
    "reason": "Inappropriate content"
  }
}

script:post-response {
  const reportId = res.getBody().id;
  bru.setVar("reportId", reportId);
}
